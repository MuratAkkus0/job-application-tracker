# MongoDB connection string used by lib/db.ts (mongoose).
MONGODB_URI=

# Better Auth server-side secret used to sign sessions/tokens.
# Generate one with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Public URL of this app, used by Better Auth on the server.
BETTER_AUTH_URL=http://localhost:3000

# Public URL of this app, used by the Better Auth client in the browser.
NEXT_PUBLIC_BETTER_AUTH_URL=http://localhost:3000

# PostHog project API key (client + server analytics).
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=

# PostHog ingestion host (defaults to PostHog Cloud EU; omit for US Cloud).
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# Optional: only used by `pnpm seed:jobs` (scripts/seed.ts) to seed sample
# job applications for a given user id.
SEED_USER_ID=
